{
    "version": 3,
    "configurePresets": [
        {
            "name": "embedded-default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "EMBEDDED_BUILD": "ON",
                "BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "Embedded-Debug",
            "inherits": "embedded-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Embedded-RelWithDebInfo",
            "inherits": "embedded-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "Embedded-Release",
            "inherits": "embedded-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Embedded-MinSizeRel",
            "inherits": "embedded-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "Host-Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Host-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "EMBEDDED_BUILD": "OFF",
                "BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Embedded-Debug",
            "configurePreset": "Embedded-Debug"
        },
        {
            "name": "Embedded-RelWithDebInfo",
            "configurePreset": "Embedded-RelWithDebInfo"
        },
        {
            "name": "Embedded-Release",
            "configurePreset": "Embedded-Release"
        },
        {
            "name": "Embedded-MinSizeRel",
            "configurePreset": "Embedded-MinSizeRel"
        },
        {
            "name": "Host-Debug",
            "configurePreset": "Host-Debug"
        }
    ],
    "testPresets": [
        {
            "name": "Host-Test",
            "displayName": "Run host unit tests",
            "configurePreset": "Host-Debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}